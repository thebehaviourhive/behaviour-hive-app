# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# demo data credentials (Phase 1 of the user-guide screenshot pipeline)
scripts/demo/.demo-credentials.json

# fba-test rig credentials (throwaway accounts for FBA module verification)
scripts/fba-test/.credentials.json

# three-track backup demo video: rendered/raw output is tens of MB and
# regenerable from the committed scripts -- never belongs in the repo,
# and would get pulled into every Vercel build if it were. The nested
# node_modules (ffmpeg-static, isolated from the root package.json so
# Vercel never installs it) and saved Playwright auth states are
# likewise throwaway/regenerable.
scripts/demo/video/out/
scripts/demo/video/raw/
scripts/demo/video/raw-*/
scripts/demo/video/node_modules/
scripts/demo/video/.auth/
scripts/demo/video/plate.png
scripts/demo/video/plate-coords.json
